---
import ScoreDeltaNote from "./ScoreDeltaNote.astro";
import type { PillarScore } from "@tightrope/shared";
import { signedDelta, trendDescriptor } from "~/lib/format.js";
import {
  mortgageDelta,
  formatExtra,
  MORTGAGE_BUDGET_BASELINE_PCT,
  MORTGAGE_BUDGET_BASELINE_LABEL,
} from "~/lib/mortgage.js";
import { shortDate } from "~/lib/format.js";
import IllustrativeBadge from "./IllustrativeBadge.astro";
import ProvenanceBadge from "./ProvenanceBadge.astro";
import IndicatorTooltip from "./IndicatorTooltip.astro";
import { INDICATORS, SOURCES } from "@tightrope/shared";

interface Props {
  pillar: PillarScore;
}

const { pillar } = Astro.props;

// Mortgage card: pull the live mortgage_2y_fix indicator from the labour
// pillar's contributions so the headline £/month figure reflects the
// latest BoE IADB (IUMBV34) reading rather than a hardcoded literal.
// Without an ingested observation we show an explicit unavailable state.
const mortgageContrib = pillar.contributions.find((c) => c.indicatorId === "mortgage_2y_fix");
const m = mortgageContrib ? mortgageDelta(MORTGAGE_BUDGET_BASELINE_PCT, mortgageContrib.rawValue, 250_000, 25) : null;
const mortgageObservedAt = mortgageContrib?.observedAt;

const inactivityRateLive = pillar.contributions.find((c) => c.indicatorId === "inactivity_rate");
const inactivityHealthLive = pillar.contributions.find((c) => c.indicatorId === "inactivity_health");
const vuLive = pillar.contributions.find((c) => c.indicatorId === "vacancies_per_unemployed");
const realPayLive = pillar.contributions.find((c) => c.indicatorId === "real_regular_pay");

// Only actual scored observations appear here. Historical-looking illustrative
// arcs previously mixed invented points and latest readings on the same axes.
const readings = [
  { id: "real_regular_pay", title: "Real total pay growth", contribution: realPayLive, note: "Annual growth in the three-month average of total pay, including bonuses, after CPIH inflation. Positive means purchasing power is rising." },
  { id: "vacancies_per_unemployed", title: "Vacancies per unemployed person", contribution: vuLive, note: "Vacancies divided by the number unemployed. Higher values indicate a tighter labour market." },
  { id: "inactivity_rate", title: "Economic inactivity rate", contribution: inactivityRateLive, note: "Share of people aged 16–64 outside the labour force. Lower means more people available to work." },
  { id: "inactivity_health", title: "Inactive due to long-term sickness", contribution: inactivityHealthLive, note: "People aged 16–64 outside the labour force due to long-term sickness." },
];
---
<section data-live-region="labour-data" data-live-valid={String(pillar.contributions.length > 0)} class="section" id="labour" aria-labelledby="labour-title">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">Pillar 3 · 20%</span>
        <h2 class="sec-title" id="labour-title" style="margin-top: 14px;">Labour & living-standards resilience</h2>
        <p class="section-sub">Health-related inactivity, labour-market tightness, real wages and — the line households feel — mortgage rates.</p>
      </div>
      <div class="pillar-score-group">
      <div class="pillar-score" aria-label={`Labour pillar score ${Math.round(pillar.value)}`}>
        <span class="pillar-score-num">{Math.round(pillar.value)}</span>
        <span class="pillar-score-sub">/100</span>
        {(() => {
          const t30 = pillar.trend30d ?? "flat";
          const d30 = typeof pillar.delta30d === "number" ? pillar.delta30d : 0;
          const cls = t30 === "up" ? "up" : t30 === "down" ? "dn" : "flat";
          return (
            <span class={`pillar-score-delta ${cls}`} title="Change across the 30-day sparkline window (first to last point).">
              {t30 === "flat" ? "flat" : (
                <>
                  {t30 === "up" ? "▲" : "▼"} {signedDelta(d30, 1)}
                  {trendDescriptor(d30) ? <span class="trend-word"> {trendDescriptor(d30)}</span> : null}
                </>
              )} / 30d
            </span>
          );
        })()}
      </div>
      <ScoreDeltaNote />
      </div>
    </div>

    <div class="labour-readings">
      {readings.map(reading => <article class="chart-card reading-card">
        <div class="card-head">
          <h3><IndicatorTooltip label={reading.title} indicatorId={reading.id} /></h3>
          <ProvenanceBadge indicatorId={reading.id} compact />
        </div>
        <p class="reading-value">{reading.contribution ? INDICATORS[reading.id]!.formatDisplay(reading.contribution.rawValue) : "—"}</p>
        <p class="reading-date">{reading.contribution ? <>Reference period · <time datetime={reading.contribution.observedAt}>{shortDate(reading.contribution.observedAt)}</time></> : "No current scored observation"}</p>
        {reading.contribution?.releasedAt ? <p class="reading-date">Released · <time datetime={reading.contribution.releasedAt}>{shortDate(reading.contribution.releasedAt)}</time></p> : null}
        <p class="reading-note">{reading.note}</p>
        <a class="reading-source" href={SOURCES[INDICATORS[reading.id]!.sourceId]!.homepage} target="_blank" rel="noopener">Source · ONS ↗</a>
      </article>)}
    </div>

    <div class="labour-grid">
      <div class="mortgage-card">
        <div class="card-head">
          <h3>Mortgage translator</h3>
          <IllustrativeBadge
            sourceSummary={`Live indicator: mortgage_2y_fix (BoE IADB IUMBV34 — monthly quoted 2-year fixed mortgage rate at 75% LTV). Baseline ${MORTGAGE_BUDGET_BASELINE_PCT.toFixed(2)}% is the IUMBV34 print for the ${MORTGAGE_BUDGET_BASELINE_LABEL}. £250k / 25-year is the worked example.`}
            sourceUrl="https://www.bankofengland.co.uk/statistics/visual-summaries/effective-interest-rates"
          />
        </div>
        <p class="hint">What the 2-year fixed-rate move means on a £250,000, 25-year repayment mortgage.</p>
        <div class="mortgage-big">{m ? formatExtra(m.extraPerMonth) : "—"}<span class="mortgage-sub"> / month</span></div>
        <p class="mortgage-caption">{m ? `Change vs. the rate at the ${MORTGAGE_BUDGET_BASELINE_LABEL} (${m.baselineRate.toFixed(2)}% → ${m.currentRate.toFixed(2)}%). Payment: £${m.currentPayment.toLocaleString("en-GB")} vs. £${m.baselinePayment.toLocaleString("en-GB")}.` : "A current mortgage-rate observation is required for this worked example."}</p>
        <p class="mortgage-note">The rate series is the Bank of England's IUMBV34 monthly quoted 2-year fixed mortgage rate at 75% LTV{mortgageObservedAt ? ` · latest reading ${shortDate(mortgageObservedAt)}` : ""}. The payment is a worked example, not a measure of actual household repayments.</p>
      </div>

      <div class="chart-card labour-context">
        <span class="eyebrow">Reading the labour pillar</span>
        <h3>Different clocks. One transparent score.</h3>
        <p>Labour statistics describe a reference period and arrive after that period ends. The dates above identify those periods; they are not real-time readings.</p>
        <p>The score combines these observations with mortgage rates and other labour inputs. Explore the recorded pillar score in the <a href="/composite">long view</a>, or inspect every current input and its weight in the <a href="/methodology">methodology</a>.</p>
      </div>
    </div>
  </div>
</section>

<style>
.section-head {
  display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 24px;
  margin-bottom: 40px;
}
.pillar-score-group { max-width: 340px; min-width: 0; }
.pillar-score { display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; font-family: var(--font-mono); }
.pillar-score-num { font-size: 40px; font-weight: 500; color: var(--ink-0); font-variant-numeric: tabular-nums; }
.pillar-score-sub { color: var(--ink-2); font-size: 14px; }
.pillar-score-delta { margin-left: 12px; font-size: 12px; }
.pillar-score-delta.up { color: var(--band-slack); }
.pillar-score-delta.dn { color: var(--band-acute); }
.pillar-score-delta.flat { color: var(--ink-2); }
.pillar-score-delta .trend-word { font-style: italic; opacity: 0.85; }

.labour-readings { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
.reading-card { padding: 20px; display: flex; flex-direction: column; }
.reading-card h3 { font-family: var(--font-sans); font-size: 13px; line-height: 1.4; font-weight: 500; }
.reading-value { font-family: var(--font-mono); font-size: 30px; letter-spacing: -.04em; font-variant-numeric: tabular-nums; margin: 20px 0 4px; line-height: 1.15; }
.reading-date { font-family: var(--font-mono); font-size: 9px; color: var(--ink-2); margin: 0 0 14px; }
.reading-note { font-size: 12px; color: var(--ink-1); line-height: 1.5; margin: 0 0 14px; }
.reading-source { color: var(--ink-2); font-family: var(--font-mono); font-size: 10px; text-decoration: underline; margin-top: auto; padding-top: 8px; }
.labour-context { display: flex; flex-direction: column; justify-content: center; }
.labour-context h3 { font-size: 25px; line-height: 1.2; margin: 18px 0 10px; }
.labour-context p { font-size: 13px; color: var(--ink-1); max-width: 580px; margin: 8px 0; }
.labour-context a { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 3px; }
.labour-grid { display: grid; grid-template-columns: 1fr 1.45fr; gap: 32px; }
.card-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 2px; }
.card-head h3 { margin: 0; }

.mortgage-card {
  background: linear-gradient(160deg, color-mix(in srgb, var(--accent) 10%, transparent), var(--bg-1));
  border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  border-radius: 12px;
  padding: 24px;
}
.mortgage-card h3 { font-family: var(--font-serif); font-weight: 400; font-size: 20px; margin: 0 0 4px; }
.mortgage-card .hint { color: var(--ink-2); font-size: 12px; margin: 0 0 16px; }
.mortgage-big { font-family: var(--font-serif); font-size: 56px; font-weight: 700; color: var(--accent); letter-spacing: -0.025em; line-height: 1; font-variant-numeric: tabular-nums; }
.mortgage-sub { font-family: var(--font-mono); font-size: 16px; color: var(--ink-2); font-weight: 400; }
.mortgage-caption { font-family: var(--font-mono); font-size: 12px; color: var(--ink-1); margin: 14px 0 10px; letter-spacing: 0.01em; }
.mortgage-note { font-size: 12.5px; color: var(--ink-1); line-height: 1.5; margin: 0; }

@media (max-width: 920px) {
  .labour-grid { grid-template-columns: 1fr; }
  .labour-readings { grid-template-columns: repeat(2, 1fr); }
  .section-head { grid-template-columns: 1fr; }
}
@media (max-width: 480px) {
  .labour-readings { grid-template-columns: 1fr; }
  .reading-value { font-size: 34px; }
}
</style>
