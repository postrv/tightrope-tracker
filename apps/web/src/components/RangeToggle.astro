---
/**
 * Range toggle pills for the long-composite chart page.
 *
 * Server-rendered links that swap the `?range=` query parameter without
 * any client JS. The active link gets `aria-current="page"` and a styled
 * highlight; the rest are normal anchors so navigation works without
 * JavaScript and is keyboard-reachable by default.
 */

import type { ScoreHistoryResolutionRequest } from "@tightrope/shared";
import { HISTORY_RANGES, historyHref, type HistoryRange } from "~/lib/historyView.js";
export type RangeOption = HistoryRange;

interface Props {
  current: RangeOption;
  /** Path to which the `?range=` query gets appended. Defaults to /composite. */
  basePath?: string;
  resolution?: ScoreHistoryResolutionRequest;
  embed?: boolean;
}

const { current, basePath = "/composite", resolution = "auto", embed = false } = Astro.props;

function hrefFor(value: RangeOption): string {
  return historyHref(value, resolution, embed, basePath);
}
---
<nav class="range-toggle" role="navigation" aria-label="Time range">
  <ul>
    {HISTORY_RANGES.map((choice) => {
      const isActive = choice.value === current;
      return (
        <li>
          <a
            href={hrefFor(choice.value)}
            class={`range-link${isActive ? " is-active" : ""}`}
            data-range={String(choice.value)}
            aria-label={choice.hint}
            aria-current={isActive ? "page" : undefined}
          >{choice.label}</a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
.range-toggle ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: inline-flex;
  gap: 4px;
  background: var(--bg-1);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 4px;
}
.range-toggle li { margin: 0; }
.range-link {
  display: inline-block;
  padding: 10px 13px;
  min-width: 42px;
  text-align: center;
  border-radius: 8px;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-2);
  transition: background var(--dur-fast), color var(--dur-fast);
}
.range-link:hover { color: var(--ink-0); }
.range-link.is-active {
  background: var(--accent);
  color: var(--bg-0);
}
.range-link:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}
@media (max-width: 600px) {
  .range-toggle { width: 100%; }
  .range-toggle ul { display: grid; grid-template-columns: repeat(6, 1fr); width: 100%; gap: 2px; }
  .range-link { padding: 11px 2px; min-width: 0; display: block; font-size: 10px; }
}
</style>
