.score-crosshair circle { fill: var(--chart-accent); stroke: var(--bg-1); stroke-width: 2; }
.score-inspector { border: 1px solid var(--border); border-radius: 10px; padding: 16px 18px 12px; background: var(--bg-0); margin-top: 12px; }
.inspector-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.inspector-heading > div:first-child { display: flex; gap: 6px; flex-direction: column; }
.inspector-navigation { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
.step-button { min-width: 34px; }
.inspector-eyebrow { font-family: var(--font-mono); font-size: 9px; color: var(--ink-2); text-transform: uppercase; letter-spacing: .1em; }
.inspector-heading time { font-family: var(--font-mono); font-size: 12px; font-weight: 500; color: var(--ink-0); }
.latest-button { font-family: var(--font-mono); font-size: 10px; background: var(--bg-1); border: 1px solid var(--border); border-radius: 6px; color: var(--ink-1); padding: 9px 11px; min-height: 34px; }
.latest-button:hover { border-color: var(--accent); }
.score-readout { display: grid; grid-template-columns: 1.2fr repeat(4, 1fr); margin: 16px 0; gap: 12px; }
