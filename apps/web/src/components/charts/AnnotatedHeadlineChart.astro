.event-label:hover .event-label-connector,
.event-label:focus-visible .event-label-connector,
.event-label[data-active="true"] .event-label-connector,
.event-label[data-pinned="true"] .event-label-connector { stroke-opacity: 0.9; }
.event-label-dot {
  pointer-events: none;
  /* Same defining ring as the plot markers, so the leading dot and the
