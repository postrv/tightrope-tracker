.pillar-key-button { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--border); background: var(--bg-0); color: var(--ink-1); border-radius: 999px; padding: 7px 11px; font-family: var(--font-mono); font-size: 11px; min-height: 34px; }
