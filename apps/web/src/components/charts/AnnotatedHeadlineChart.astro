.inspector-bottom .inspector-hint { max-width: 540px; }
.jump-label { display: flex; flex-direction: column; gap: 4px; font-size: 9px; color: var(--ink-2); font-family: var(--font-mono); white-space: nowrap; }
.jump-label input { font-family: var(--font-mono); font-size: 10px; color: var(--ink-1); background: var(--bg-1); border: 1px solid var(--border); border-radius: 6px; padding: 7px; min-height: 34px; min-width: 0; }
.band-key { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 18px 0; }
.band-key > span { display: inline-flex; align-items: center; gap: 5px; font-size: 10px; color: var(--ink-2); }
.band-key i { display: inline-block; height: 7px; width: 16px; background: var(--key-colour); border-radius: 2px; border: 1px solid color-mix(in srgb, var(--ink-0) 15%, transparent); }
.band-key b { font-family: var(--font-mono); font-size: 9px; font-weight: 400; }
.history-provenance { color: var(--ink-2); font-size: 11px; line-height: 1.6; margin: 0 0 16px; }
.history-provenance a { color: var(--ink-1); text-decoration: underline; text-underline-offset: 2px; }
.event-key { display: flex; flex-wrap: wrap; gap: 9px 16px; align-items: center; border-top: 1px solid var(--border-soft); padding-top: 14px; color: var(--ink-1); font-family: var(--font-mono); font-size: 10px; }
.key-heading { text-transform: uppercase; letter-spacing: .08em; font-size: 9px; color: var(--ink-2); }
.event-key-item { display: inline-flex; align-items: center; gap: 6px; }
.event-key-item i { width: 8px; height: 8px; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--ink-0) 30%, transparent); }
.event-key-item b { font-weight: 400; color: var(--ink-2); }
.event-key p { width: 100%; margin: 0; font-family: var(--font-sans); color: var(--ink-2); font-size: 11px; }
.event-list { border-top: 1px solid var(--border-soft); margin-top: 14px; font-size: 12px; }
