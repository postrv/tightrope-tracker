.event-label {
  cursor: default;
  outline: none;
  pointer-events: none;
  touch-action: manipulation;
}
.chart-svg[data-labels="false"] .event-label { display: none; }
.event-label-hit {
  fill: transparent;
  stroke: transparent;
  pointer-events: all;
  cursor: pointer;
}
.event-label-connector {
  cursor: default;
  pointer-events: none;
  /* Connectors are structure, not identity — they wear quiet ink so five
