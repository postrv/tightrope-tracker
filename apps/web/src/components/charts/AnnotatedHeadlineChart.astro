.score-readout > div:first-child { border-left: 3px solid var(--chart-accent); padding-left: 10px; }
.score-readout dt { font-size: 11px; color: var(--ink-2); }
.score-readout dd { font-family: var(--font-mono); font-size: 22px; font-weight: 500; font-variant-numeric: tabular-nums; margin: 3px 0 0; color: var(--ink-0); line-height: 1.25; }
.score-readout dd small { font-size: 10px; margin-left: 3px; color: var(--ink-2); font-weight: 400; }
