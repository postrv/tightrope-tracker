  width: 240px;
  max-width: calc(100% - 16px);
  background: var(--bg-1);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 10px 12px;
  font-family: var(--font-sans);
  font-size: 12.5px;
  color: var(--ink-1);
  box-shadow: var(--shadow-md);
  opacity: 0;
  visibility: hidden;
  transition: opacity 140ms ease-out;
  pointer-events: none;
  z-index: 5;
