---
/**
 * Server-rendered SVG line chart of the headline Tightrope Score over time,
 * with timeline-event markers snapped to the nearest history point.
 *
 * Designed to be the homepage's "long view" — sits below the hero, shows
 * how the score has moved across the visible window, and pins the events
 * that drove the moves so the chart reads at a glance.
 *
 * The chart is server-rendered SVG with a tiny interaction shim for hover,
 * focus, and tap-to-pin tooltips. Each event marker is keyboard-focusable
 * (`tabindex="0"`) and has a per-marker `aria-label`. The SVG element itself
 * carries a numeric ARIA summary so screen-reader users never have to "read"
 * a path.
 */
import type { ScoreHistory } from "@tightrope/shared";
import type { TimelineEvent, TimelineCategory } from "@tightrope/shared/timeline";
import { BANDS, bandFor, PILLAR_ORDER, PILLARS } from "@tightrope/shared";
import { shortDate, bstTimestamp } from "~/lib/format.js";
import { mapEventsToChart } from "~/lib/chartAnnotations.js";
import { safeHref } from "~/lib/safeHref.js";
import { safeJsonForScriptTag } from "~/lib/safeJson.js";
import { timeRatio, scoreGapThreshold, scoreLinePath } from "~/lib/scoreChart.js";
import { chartTickLabel, RESOLUTION_LABELS } from "~/lib/historyView.js";
import { EVENT_STYLES, PILLAR_STYLES } from "~/lib/chartTheme.js";

interface Props {
  history: ScoreHistory;
  events: readonly TimelineEvent[];
  width?: number;
  height?: number;
  /** When true, render four faint pillar lines under the headline series. Off by default. */
  showPillars?: boolean;
}

const {
  history,
  events,
  width = 880,
  height = 320,
  showPillars = false,
} = Astro.props;

// --- layout constants -----------------------------------------------------
// Padding leaves room for left axis labels (0..100), bottom date ticks, and
// three rows of permanent event labels above + three rows below the plot. The
// extra top/bottom space is what lets dense Budget-clustered events stagger
// across multiple lanes instead of piling up in two parity rows.
const padL = 44;
const padR = 16;
const padT = 44;
const padB = 64;
const plotW = width - padL - padR;
const plotH = height - padT - padB;
// Per-lane y-anchors for the six-row label layout. Three lanes sit in padT,
// three in padB. Each holds one label per chart-x-position before spilling to
// the next lane. The closest lanes are first so the common case stays visually
// tight to the marker.
const LABEL_LANES = [
  { y: padT - 6, above: true },   // above row 0 — closest to plot
  { y: padT - 20, above: true },
  { y: padT - 34, above: true },
  { y: padT + plotH + 14, above: false }, // below row 0
  { y: padT + plotH + 28, above: false },
  { y: padT + plotH + 42, above: false }, // below row 2 (above date ticks)
] as const;

// --- band-tinted background regions and y-axis ticks ----------------------
// We anchor the y-axis to the canonical band boundaries (0, 20, 40, 60, 80, 100)
// rather than the data's min/max so the chart's vertical position is
// directly comparable across reads — a 70 in March is the same height as
// a 70 in April. Boundaries come from BANDS so any future re-banding
// flows through automatically.
function yFor(score: number): number {
  // 0 = bottom of plot (worst), 100 = top of plot (best). Higher score
  // pushes the line UP because higher = more room to move.
  const clamped = Math.max(0, Math.min(100, score));
  return padT + plotH - (clamped / 100) * plotH;
}

// Canonical boundaries for grid lines and band regions. We append 100 as
// the upper bound — BANDS gives [0,20), [20,40), [40,60), [60,80), [80,101)
// so the unique min values + 100 give us the full fence.
const boundaries: readonly number[] = [
  ...new Set(BANDS.map((b) => b.min)),
  100,
];
const yTicks = boundaries.map((v) => ({ value: v, y: yFor(v) }));

// Pre-compute band-tinted background regions. Done in the frontmatter so
// the template can render with a clean `.map()` — Astro's compiler is
// strict about early-return patterns inside JSX expressions.
const bandRegions = BANDS.flatMap((band) => {
  const top = yFor(Math.min(100, band.max));
  const bottom = yFor(band.min);
  const h = bottom - top;
  if (h <= 0) return [];
  return [{ y: top, h, min: band.min, max: band.max, colourToken: band.colourToken }];
});

// --- headline path --------------------------------------------------------
const points = history.points.filter(p => Number.isFinite(p.headline) && Number.isFinite(Date.parse(p.timestamp)))
  .slice().sort((a, b) => Date.parse(a.timestamp) - Date.parse(b.timestamp));
function xFor(timestamp: string): number {
  if (!points.length) return padL + plotW / 2;
  return padL + timeRatio(timestamp, points[0]!.timestamp, points[points.length - 1]!.timestamp) * plotW;
}
const headlineSeries = points.map((p) => p.headline);
const latestHeadline = headlineSeries.length ? headlineSeries[headlineSeries.length - 1]! : 0;
const accentBand = bandFor(latestHeadline);
const resolution = history.resolution ?? "daily";
const maxGapMs = scoreGapThreshold(resolution);

// pathFromSeries normalises the y-axis to the data range; we want a fixed
// 0..100 scale so band regions line up. Build the path manually using yFor.
function pointsToPath(series: readonly number[]): string {
  if (series.length === 0) return "";
  if (series.length === 1) {
    const x = padL + plotW / 2;
    return `M${x.toFixed(2)},${yFor(series[0]!).toFixed(2)}`;
  }
  return scoreLinePath(series.map((v, i) => ({ x: xFor(points[i]!.timestamp), y: yFor(v), timestamp: points[i]!.timestamp })), maxGapMs);
}
const headlineD = pointsToPath(headlineSeries);

// Optional faint pillar lines — useful on the long-composite page; the
// homepage uses the default `showPillars=false`.
const pillarPaths = showPillars
  ? PILLAR_ORDER.map((p) => ({
      id: p,
      label: PILLARS[p].shortTitle,
      d: pointsToPath(points.map((pt) => pt.pillars[p] ?? 0)),
    }))
  : [];

// --- annotations ----------------------------------------------------------
const annotations = mapEventsToChart({ ...history, points }, events);
const eventKey = [...new Set(annotations.map(a => a.event.category))].map(category => ({
  ...EVENT_STYLES[category],
  count: annotations.filter(a => a.event.category === category).length,
}));
const latestPoint = points[points.length - 1];
const sampleData = { width, padL, plotW, maxGapMs,
  responsive: { width, height, padL, padR, padT, padB },
  points: points.map(point => ({ ...point, x: xFor(point.timestamp), y: yFor(point.headline) })) };

/** Titles are abbreviated to keep the SVG legible — the full title remains
 * accessible via the tooltip and label hover/focus target.
 */
const LABEL_MAX_CHARS = 24;
function abbreviateEventTitle(title: string): string {
  // Prefer the leading clause, but do not reduce short actor-led titles
  // ("US, Israel and Iran agree...") to a single ambiguous token.
  const normalised = title.replace(/\s+/g, " ").trim();
  const clauseMatch = normalised.match(/^(.+?)(?:,|:|\s[—–-]\s)/);
  let head = clauseMatch?.[1]?.trim() ?? normalised;
  if (head.split(/\s+/).length < 2 && normalised.length > head.length) {
    const keyword = normalised.match(/\b(ceasefire|budget|forecast|headroom|inflation|CPI|rates?|conflict)\b/i)?.[0];
    head = keyword ? `${head} ${keyword}` : normalised;
  }
  if (head.length <= LABEL_MAX_CHARS) return head;
  // Cut at a WORD boundary, never mid-word — "Prime Minister announ…" reads
  // worse than a shorter but whole "Prime Minister…". Trailing connective
  // words and punctuation are stripped so the fragment ends on a content word.
  let cut = head.slice(0, LABEL_MAX_CHARS);
  const lastSpace = cut.lastIndexOf(" ");
  if (lastSpace > 0) cut = cut.slice(0, lastSpace);
  cut = cut.replace(/(?:\s+(?:and|or|of|the|to|a|an|in|on|as|for|its|his|her))+$/i, "").replace(/[,;:.\s]+$/, "");
  return `${cut}…`;
}
const labelledAnnotations = annotations;

// --- label collision-resolving placement ----------------------------------
// The previous algorithm staggered labels above/below by index parity, which
// piles up two adjacent fiscal events on the same line whenever they happen
// to share parity (e.g. a Budget plus the OBR commentary on the same week).
// Pack into six lanes greedily by xRatio, dropping any label that doesn't fit
// — the marker dot remains, so the event is still readable on hover, but the
// chart never collapses into stacked overlapping text.
const LABEL_CHAR_WIDTH = 6.2; // ~10.5px monospace, conservative
const LABEL_GAP_PX = 10;
/** Horizontal room reserved for the category dot that leads each label. */
const LABEL_DOT_SPACE = 11;

interface PlacedLabel {
  annotation: typeof labelledAnnotations[number];
  cx: number;
  cy: number;
  /** Left edge of the full label extent (dot + text). */
  labelLeft: number;
  /** Full extent width (dot + text). */
  labelWidth: number;
  /** x of the text start — always rendered with text-anchor="start". */
  textX: number;
  labelY: number;
  /** Where the connector meets the label row — the extent edge nearest the marker. */
  connectorX: number;
  above: boolean;
  text: string;
}

function placeLabels(
  inputs: readonly typeof labelledAnnotations[number][],
): readonly PlacedLabel[] {
  const sorted = [...inputs].sort((a, b) => a.xRatio - b.xRatio);
  const laneRightEdge = LABEL_LANES.map(() => Number.NEGATIVE_INFINITY);
  const out: PlacedLabel[] = [];
  for (const a of sorted) {
    const text = abbreviateEventTitle(a.event.title);
    const width = LABEL_DOT_SPACE + text.length * LABEL_CHAR_WIDTH;
    const cx = padL + a.xRatio * plotW;
    const cy = yFor(a.value);
    // Single anchoring model: every label is a start-anchored [dot + text]
    // block whose left edge is the marker-centred position clamped into the
    // plot bounds. One code path means the connector target below is always
    // derived the same way — the old middle/start/end anchor switching is
    // what let clamped edge labels drift away from their connectors.
    const minX = padL + 2;
    const maxX = padL + plotW - 2;
    const labelLeft = Math.min(Math.max(cx - width / 2, minX), Math.max(minX, maxX - width));
    const labelRight = labelLeft + width;
    let assignedLane = -1;
    for (let i = 0; i < LABEL_LANES.length; i++) {
      if (labelLeft > laneRightEdge[i]! + LABEL_GAP_PX) {
        assignedLane = i;
        laneRightEdge[i] = labelRight;
        break;
      }
    }
    if (assignedLane === -1) continue; // dot stays; permanent label dropped
    const lane = LABEL_LANES[assignedLane]!;
    out.push({
      annotation: a,
      cx,
      cy,
      labelLeft,
      labelWidth: width,
      textX: labelLeft + LABEL_DOT_SPACE,
      labelY: lane.y,
      // The connector lands on the label extent at the point nearest the
      // marker's x — directly above/below the marker when the label wasn't
      // clamped, at the extent's edge when it was.
      connectorX: Math.min(Math.max(cx, labelLeft + 4), labelRight - 4),
      above: lane.above,
      text,
    });
  }
  return out;
}

const placedLabels = placeLabels(labelledAnnotations);

// Map TimelineCategory → CSS variable. Markers stay readable on the cream
// background and align with how the rest of the site colours each kind
// of event. Five visual groups, validated (dataviz six-checks) on both
// surfaces: the chromatic trio (orange / amber / teal) passes lightness,
// chroma, and CVD separation; the two ink slots are deliberate achromatics
// (geopolitical = full ink, policy/delivery = muted ink) whose identity
// relief is the permanent label + legend + tooltip. `political` gets its
// own teal — this window mixes Westminster and war events, and both wearing
// ink-0 made the two kinds indistinguishable.
function colourFor(category: TimelineCategory): string {
  return EVENT_STYLES[category]?.colour ?? "var(--accent)";
}

function tooltipIdFor(eventId: string): string {
  const safeId = eventId.replace(/[^a-zA-Z0-9_-]/g, "-");
  return `tooltip-${idScope}-${safeId}`;
}

// --- date ticks (sparse) --------------------------------------------------
// Render at most ~6 date labels so the x-axis stays readable. We pick the
// first, last, and a roughly-evenly-spaced set in between.
const dateTicks: { x: number; label: string; timestamp: string; anchor: "start" | "middle" | "end" }[] = [];
if (points.length > 0) {
  const TARGET_TICKS = Math.min(6, points.length);
  const step = points.length === 1 ? 1 : (points.length - 1) / (TARGET_TICKS - 1);
  for (let i = 0; i < TARGET_TICKS; i++) {
    const idx = Math.min(points.length - 1, Math.round(i * step));
    const x = xFor(points[idx]!.timestamp);
    // End ticks hug the plot edges: a centred label at the last point would
    // overflow the 16px right pad and clip mid-glyph ("12 Jul 2…").
    const anchor = i === 0 ? "start" : i === TARGET_TICKS - 1 ? "end" : "middle";
    const timestamp = points[idx]!.timestamp;
    const span = Date.parse(points.at(-1)!.timestamp) - Date.parse(points[0]!.timestamp);
    dateTicks.push({ x, label: chartTickLabel(timestamp, span), timestamp, anchor });
  }
}

// --- numeric ARIA summary -------------------------------------------------
const finite = headlineSeries.filter((n) => Number.isFinite(n));
const first = finite.length ? finite[0]! : null;
const last = finite.length ? finite[finite.length - 1]! : null;
const lo = finite.length ? Math.min(...finite) : null;
const hi = finite.length ? Math.max(...finite) : null;
function fmt(n: number): string {
  return Math.abs(n) >= 100 ? Math.round(n).toString() : n.toFixed(1);
}
const ariaSummary = first !== null && last !== null && lo !== null && hi !== null
  ? `Headline Tightrope Score across ${finite.length} recording${finite.length === 1 ? "" : "s"}, from ${bstTimestamp(points[0]!.timestamp)} to ${bstTimestamp(points.at(-1)!.timestamp)}: starts ${fmt(first)}, ends ${fmt(last)}, range ${fmt(lo)} to ${fmt(hi)}. ${annotations.length} event${annotations.length === 1 ? "" : "s"} annotated.`
  : "Headline Tightrope Score over time — no data yet.";

// Stable IDs derived from chart dimensions so multiple charts on one page
// don't collide. Astro's slot-style scoping doesn't extend to SVG <defs>.
const idScope = `chart-${width}x${height}`;
const eventStamp = (date: string) => date.includes("T") ? bstTimestamp(date) : shortDate(date);
---
<div class="annotated-chart" style={`--chart-accent: var(${accentBand.colourToken});`}>
  <div class="chart-key" aria-label="Chart series and score direction">
    <span class="series-key"><span class="line-swatch headline-swatch" aria-hidden="true"></span><strong>Headline score</strong></span>
    <span class="score-direction">0–100 · higher = more room to move ↑</span>
    {showPillars ? <div class="pillar-key" aria-label="Toggle pillar lines">
      {PILLAR_ORDER.map(p => <button type="button" class="pillar-key-button" data-toggle-pillar={p} aria-pressed="true" title={`Show or hide ${PILLARS[p].shortTitle} line`}>
        <svg width="22" height="10" aria-hidden="true"><line x1="0" y1="5" x2="22" y2="5" stroke={PILLAR_STYLES[p].colour} stroke-width="2" stroke-dasharray={PILLAR_STYLES[p].dash} /></svg>
        {PILLARS[p].shortTitle}
      </button>)}
    </div> : null}
  </div>
  <svg
    class="chart-svg"
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-label={ariaSummary}
    preserveAspectRatio="none"
  >
    <defs>
      <linearGradient id={`fill-${idScope}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--chart-accent)" stop-opacity="0.18" />
        <stop offset="1" stop-color="var(--chart-accent)" stop-opacity="0" />
      </linearGradient>
    </defs>

    {/* Band-tinted regions: subtle horizontal stripes mapping each band's range. */}
    {bandRegions.map((r) => (
      <rect
        data-band-min={r.min}
        data-band-max={r.max}
        x={padL}
        y={r.y}
        width={plotW}
        height={r.h}
        fill={`var(${r.colourToken})`}
        fill-opacity="0.05"
      />
    ))}

    {/* Y-axis grid lines + tick labels at band boundaries. */}
    <g class="grid">
      {yTicks.map((t) => (
        <line x1={padL} y1={t.y} x2={padL + plotW} y2={t.y} class="grid-line" data-score-tick={t.value} />
      ))}
      {yTicks.map((t) => (
        <text x={padL - 8} y={t.y + 4} text-anchor="end" class="axis-label" data-score-tick={t.value}>{t.value}</text>
      ))}
    </g>

    {/* Optional pillar series — faint so the headline reads first. */}
    {pillarPaths.map((p) => (
      <path
        d={p.d}
        class={`pillar-line pillar-${p.id}`}
        data-pillar={p.id}
        stroke={PILLAR_STYLES[p.id].colour}
        stroke-dasharray={PILLAR_STYLES[p.id].dash}
        fill="none"
        stroke-width="1"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    ))}

    {/* Headline fill + line. */}
    {headlineSeries.length > 1 && !headlineD.includes(" M") ? (
      <path
        d={`${headlineD} L${(padL + plotW).toFixed(2)},${(padT + plotH).toFixed(2)} L${padL.toFixed(2)},${(padT + plotH).toFixed(2)} Z`}
        fill={`url(#fill-${idScope})`}
        class="headline-fill"
      />
    ) : null}
    <path
      d={headlineD}
      class="headline-line"
      fill="none"
      stroke="var(--chart-accent)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    {latestPoint ? <g class="score-crosshair" aria-hidden="true" pointer-events="none">
      <line x1={xFor(latestPoint.timestamp)} x2={xFor(latestPoint.timestamp)} y1={padT} y2={padT + plotH} />
      <circle cx={xFor(latestPoint.timestamp)} cy={yFor(latestPoint.headline)} r="4" />
    </g> : null}

    {/* Event annotations. */}
    {annotations.map((a) => {
      const cx = padL + a.xRatio * plotW;
      const cy = yFor(a.value);
      const colour = colourFor(a.event.category);
      return (
        <g
          class="marker"
          tabindex="0"
          role="button"
          aria-pressed="false"
          aria-describedby={tooltipIdFor(a.event.id)}
          aria-label={`${a.event.title}, ${eventStamp(a.event.date)}`}
          data-event-id={a.event.id}
          data-chart-x={a.xRatio}
          data-chart-score={a.value}
        >
          {/* Vertical guide line from the data point down to the x-axis. */}
          <line
            x1={cx}
            y1={cy}
            x2={cx}
            y2={padT + plotH}
            class="marker-guide"
            stroke-dasharray="2 3"
          />
          {/* Invisible hit target. The visible dot stays at r=5 for visual
              density; this widens the actual tap area to the WCAG 2.5.8
              floor on touch devices. */}
          <circle cx={cx} cy={cy} r="14" class="marker-hit" />
          {/* The thin ink ring is the contrast relief for the palette's pale
              hues (amber prints ~2:1 on cream) — every dot stays findable
              regardless of its category colour. */}
          <circle cx={cx} cy={cy} r="5" fill={a.event.category === "methodology" ? "var(--bg-1)" : colour} class="marker-dot" stroke={a.event.category === "methodology" ? colour : "var(--ink-0)"} stroke-opacity={a.event.category === "methodology" ? "1" : "0.35"} stroke-width="1" stroke-dasharray={EVENT_STYLES[a.event.category].dash} />
          <circle cx={cx} cy={cy} r="2" fill="var(--bg-0)" class="marker-dot-inner" />
        </g>
      );
    })}

    {/* Permanent labels for charted events, packed
        into six lanes (three above plot, three below) by xRatio with greedy
        collision resolution. Labels that can't fit any lane are dropped —
        the marker dot still renders so the event remains hover-discoverable
        but the chart never collapses into overlapping text. */}
    {placedLabels.map((p) => {
      const colour = colourFor(p.annotation.event.category);
      // Above-plot labels connect from the marker itself; below-plot labels
      // connect from the plot floor — the dashed marker-guide already walks
      // the eye from the marker down to the axis, so restarting there keeps
      // a below label from dragging a second full-height line through the
      // fill. When the label was clamped away from the marker's x the path
      // takes a rounded elbow to the extent edge nearest the marker.
      const startY = p.above ? p.cy - 6 : padT + plotH;
      const endY = p.above ? p.labelY + 4 : p.labelY - 10;
      const needsElbow = Math.abs(p.connectorX - p.cx) > 1;
      const connectorD = needsElbow
        ? `M${p.cx.toFixed(2)},${startY.toFixed(2)} V${(p.above ? endY + 8 : endY - 8).toFixed(2)} Q${p.cx.toFixed(2)},${endY.toFixed(2)} ${(p.cx + Math.sign(p.connectorX - p.cx) * 8).toFixed(2)},${endY.toFixed(2)} H${p.connectorX.toFixed(2)}`
        : `M${p.cx.toFixed(2)},${startY.toFixed(2)} V${endY.toFixed(2)}`;
      return (
        <g
          class="event-label"
          tabindex="0"
          role="button"
          aria-pressed="false"
          aria-describedby={tooltipIdFor(p.annotation.event.id)}
          aria-label={`${p.annotation.event.title}, ${eventStamp(p.annotation.event.date)}`}
          data-event-id={p.annotation.event.id}
        >
          <rect
            x={p.labelLeft - 4}
            y={p.labelY - 12}
            width={p.labelWidth + 8}
            height="18"
            rx="3"
            class="event-label-hit"
          />
          <path
            d={connectorD}
            class="event-label-connector"
            fill="none"
          />
          {/* Identity lives in the leading dot; the text wears ink with a
              surface-coloured halo so a connector or gridline can never
              strike through it. */}
          <circle
            cx={p.labelLeft + 4}
            cy={p.labelY - 3.5}
            r="3.5"
            fill={colour}
            class="event-label-dot"
          />
          <text
            x={p.textX}
            y={p.labelY}
            text-anchor="start"
            class="event-label-text"
          >{p.text}</text>
        </g>
      );
    })}

    {/* X-axis date ticks. data-tick-i lets the mobile CSS hide alternates
        without re-running the layout — at 6 ticks across an ~340px phone
        the labels overlap; on mobile we retain the first and last ticks. */}
    {dateTicks.map((t, i) => (
      <text
        x={t.x}
        y={height - 10}
        text-anchor={t.anchor}
        class="axis-label date-tick"
        data-tick-i={i}
        data-chart-date={t.timestamp}
      >{t.label}</text>
    ))}
  </svg>

  {/* Tooltips: one per marker. They're absolute-positioned siblings of the
      SVG so they can render outside the SVG's clipping rect. Anchored via
      the same xRatio used to place the marker. */}
  <div class="tooltip-layer">
    {annotations.map((a) => {
      const leftPct = ((padL + a.xRatio * plotW) / width) * 100;
      const colour = colourFor(a.event.category);
      const summary = a.event.summary.length > 140 ? `${a.event.summary.slice(0, 137)}…` : a.event.summary;
      return (
        <div
          id={tooltipIdFor(a.event.id)}
          class="tooltip"
          role="tooltip"
          data-event-id={a.event.id}
          data-chart-x={a.xRatio}
          style={`left: ${leftPct.toFixed(2)}%;`}
        >
          <div class="tooltip-head">
            <span class="tooltip-cat" style={`color: ${colour}; border-color: ${colour};`}>{EVENT_STYLES[a.event.category].label}</span>
            <span class="tooltip-date">{eventStamp(a.event.date)}</span>
          </div>
          <div class="tooltip-title">{a.event.title}</div>
          <div class="tooltip-summary">{summary}</div>
          <div class="tooltip-score">Nearest recorded headline: <strong>{a.value.toFixed(1)} / 100</strong><span>{bstTimestamp(points[a.seriesIndex]!.timestamp)} · {resolution} sampling</span></div>
          <div class="tooltip-source">
            {/* SEC-6: a.event.sourceUrl is operator-curated in D1. Allowlist http(s). */}
            Source: {(() => {
              const href = safeHref(a.event.sourceUrl);
              return href
                ? <a href={href} target="_blank" rel="noopener">{a.event.sourceLabel} ↗</a>
                : <span>{a.event.sourceLabel}</span>;
            })()}
          </div>
        </div>
      );
    })}
  </div>

  {latestPoint ? <>
    <script type="application/json" class="score-chart-data" set:html={safeJsonForScriptTag(sampleData)} />
    <div class="score-inspector">
      <div class="inspector-heading">
        <div><span class="inspector-eyebrow" data-score-position>Latest · {points.length} / {points.length}</span><time datetime={latestPoint.timestamp} data-score-date>{bstTimestamp(latestPoint.timestamp)}</time></div>
        <div class="inspector-navigation" aria-label="Move between recordings">
          <button type="button" class="latest-button step-button" data-score-previous aria-label="Previous recorded score">←</button>
          <button type="button" class="latest-button step-button" data-score-next aria-label="Next recorded score">→</button>
          <button type="button" class="latest-button" data-score-reset>Latest ↗</button>
        </div>
      </div>
      <dl class="score-readout" aria-label="Scores at selected recording">
        <div class="headline-readout"><dt>Headline</dt><dd><span data-score-value="headline">{latestPoint.headline.toFixed(1)}</span><small>/100</small></dd></div>
        {PILLAR_ORDER.map(p => <div><dt>{PILLARS[p].shortTitle}</dt><dd data-score-value={p}>{Number.isFinite(latestPoint.pillars[p]) ? latestPoint.pillars[p].toFixed(1) : "—"}</dd></div>)}
      </dl>
      <label class="scrubber-label">Explore recorded scores
        <input class="score-scrubber" type="range" min="0" max={points.length - 1} value={points.length - 1} step="1" aria-label="Recorded score date. Use arrow keys to move through history." />
      </label>
      <div class="inspector-bottom"><p class="inspector-hint">{RESOLUTION_LABELS[resolution]}. Hover to inspect · tap to pin · arrow keys on the slider · Escape for latest.</p>
        <label class="jump-label">Jump to UTC <input type="datetime-local" data-score-jump min={points[0]!.timestamp.slice(0, 16)} max={latestPoint.timestamp.slice(0, 16)} aria-label="Jump to nearest recorded date and time in UTC" /></label>
      </div>
    </div>
  </> : null}

  <div class="band-key" aria-label="Score bands">
    {BANDS.map(band => <span style={`--key-colour: var(${band.colourToken});`}><i aria-hidden="true"></i>{band.label} <b>{band.min}–{band.max > 100 ? "100" : `<${band.max}`}</b></span>)}
  </div>
  <p class="history-provenance">Recorded scores include the marked data and calculation corrections: a change across those markers is not purely an economic move. Earlier daily history also includes reconstructions and later source revisions. <a href="/methodology#historical-coverage">See historical coverage and methodology.</a></p>
  {eventKey.length ? <div class="event-key" aria-label="Event marker key">
    <span class="key-heading">Event markers</span>
    {eventKey.map(item => <span class="event-key-item"><i style={`background: ${item.dash ? "transparent" : item.colour}; ${item.dash ? `border-style: dashed; border-color: ${item.colour};` : ""}`} aria-hidden="true"></i>{item.label} <b>{item.count}</b></span>)}
    <p>Events provide context. A nearby score move does not establish cause.</p>
  </div> : null}
  {annotations.length ? <details class="event-list">
    <summary>Read the {annotations.length} charted event{annotations.length === 1 ? "" : "s"} & sources</summary>
    <ol>{annotations.map(annotation => <li>
      <div class="event-list-date"><time datetime={annotation.event.date}>{eventStamp(annotation.event.date)}</time><span>{EVENT_STYLES[annotation.event.category].label}</span></div>
      <strong>{annotation.event.title}</strong>
      <p>{annotation.event.summary}</p>
      {safeHref(annotation.event.sourceUrl) ? <a href={safeHref(annotation.event.sourceUrl)!} target="_blank" rel="noopener">{annotation.event.sourceLabel} ↗</a> : <span>{annotation.event.sourceLabel}</span>}
    </li>)}</ol>
  </details> : null}
</div>

<script>
  import { initialiseScoreCharts } from "~/lib/scoreChartInteraction.js";
  import { initialiseChartEvents } from "~/lib/chartEventInteraction.js";
  initialiseScoreCharts();
  initialiseChartEvents();
</script>

<style>
