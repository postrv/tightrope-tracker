  stroke: var(--ink-0);
  stroke-opacity: 0.35;
  stroke-width: 1;
}
.event-label-text {
  font-family: var(--font-mono);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.02em;
  cursor: pointer;
  pointer-events: none;
  user-select: none;
